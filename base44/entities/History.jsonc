{
  "name": "History",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "favicon": {
      "type": "string",
      "default": ""
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}